{
  "name": "zent-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:desktop": "tsc -p electron/tsconfig.json && concurrently \"next dev --port 3000\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "build": "next build",
    "build:web": "next build",
    "build:desktop": "tsc -p electron/tsconfig.json && next build && electron-builder",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@yxc/types": "file:../zent-server/packages/types",
    "@yxc/permissions": "file:../zent-server/packages/permissions",
    "@yxc/gateway-types": "file:../zent-server/packages/gateway-types",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0",
    "@tanstack/react-query": "^5.62.0",
    "socket.io-client": "^4.8.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.468.0",
    "react-virtuoso": "^4.12.0",
    "date-fns": "^4.1.0",
    "emoji-mart": "^5.6.0",
    "@emoji-mart/data": "^1.2.0",
    "@emoji-mart/react": "^1.1.0",
    "sonner": "^1.7.0",
    "livekit-client": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  }
}
